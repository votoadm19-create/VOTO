# Copie para .env e ajuste. O .env é ignorado pelo git — nunca commite segredos.

PORT=3000

# Administrador inicial (usado só na primeira execução, quando ainda não há admin)
ADMIN_USER=admin
ADMIN_PASS=troque-por-uma-senha-forte

# 1 em produção (HTTPS). Deixe vazio/0 em localhost.
COOKIE_SECURE=

# 1 para criar a conta demo larissa@exemplo.com / voto1234 em bancos novos.
# Deixe vazio em produção.
VOTO_SEED_DEMO=
